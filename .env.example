# Copy to .env.local (never commit). In Vercel: Project > Settings > Environment Variables.
AUTH_ENABLED=false            # set to true once the values below are filled
AUTH_SECRET=                  # random 32+ bytes: `openssl rand -base64 32`
AUTH_URL=https://amrsystems.vercel.app
AUTH_GOOGLE_ID=               # Google Cloud OAuth client ID
AUTH_GOOGLE_SECRET=           # Google Cloud OAuth client secret
DATABASE_URL=                 # Neon Postgres connection string (sslmode=require)
